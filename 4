    class EmailValidator : IValidator<string>
    {
        private List<string> errors = new List<string>();

        public bool Validate(string email)
        {
            errors.Clear();

            if (string.IsNullOrWhiteSpace(email))
            {
                errors.Add("Email не может быть пустым");
                return false;
            }

            if (!email.Contains("@"))
            {
                errors.Add("Email должен содержать @");
                return false;
            }

            if (!email.Contains("."))
            {
                errors.Add("Email должен содержать точку");
                return false;
            }

            if (email.Length < 5)
            {
                errors.Add("Email слишком короткий");
                return false;
            }

            return true;
        }

        public List<string> GetErrors()
        {
            return errors;
        }
    }

