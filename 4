    class Password
    {
        private string password;

        public string PasswordValue
        {
            get { return "***"; } 
            set
            {
                if (!IsValidPassword(value))
                    throw new ArgumentException("Пароль не соответствует требованиям безопасности!");
                password = value;
            }
        }

        public Password(string password)
        {
            PasswordValue = password;
        }

        private bool IsValidPassword(string password)
        {
            if (string.IsNullOrWhiteSpace(password) || password.Length < 8)
                return false;

            bool hasUpper = false;
            bool hasLower = false;
            bool hasDigit = false;

            foreach (char c in password)
            {
                if (char.IsUpper(c)) hasUpper = true;
                if (char.IsLower(c)) hasLower = true;
                if (char.IsDigit(c)) hasDigit = true;
            }

            return hasUpper && hasLower && hasDigit;
        }

        public bool Verify(string inputPassword)
        {
            return password == inputPassword;
        }

        public void DisplayStrength()
        {
            Console.WriteLine("Пароль соответствует требованиям безопасности");
        }
    }

    class Email
    {
        private string email;

        public string EmailAddress
        {
            get { return email; }
            set
            {
                if (!IsValidEmail(value))
                    throw new ArgumentException("Некорректный email адрес!");
                email = value;
            }
        }

        public Email(string email)
        {
            EmailAddress = email;
        }

        private bool IsValidEmail(string email)
        {
            if (string.IsNullOrWhiteSpace(email))
                return false;

            string[] parts = email.Split('@');
            if (parts.Length != 2)
                return false;

            if (string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
                return false;

            if (!parts[1].Contains("."))
                return false;

            return true;
        }

        public string GetDomain()
        {
            return email.Split('@')[1];
        }

        public void DisplayInfo()
        {
            Console.WriteLine($"Email: {email}");
            Console.WriteLine($"Домен: {GetDomain()}");
        }
    }

