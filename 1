    partial class BankAccount
    {
        public void Deposit(decimal amount)
        {
            if (amount > 0)
            {
                Balance += amount;
                LogTransaction($"Пополнение: +{amount}, Баланс: {Balance}");
            }
        }

        public bool Withdraw(decimal amount)
        {
            if (amount > 0 && Balance >= amount)
            {
                Balance -= amount;
                LogTransaction($"Снятие: -{amount}, Баланс: {Balance}");
                return true;
            }
            return false;
        }

        private void LogTransaction(string message)
        {
            Console.WriteLine($"[Банковский счет {AccountNumber}] {message}");
        }
    }

