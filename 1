    partial class Book
    {
        public bool MatchesSearch(string searchTerm)
        {
            if (string.IsNullOrEmpty(searchTerm))
                return false;

            return (Title != null && Title.IndexOf(searchTerm, StringComparison.OrdinalIgnoreCase) >= 0) ||
                   (Author != null && Author.IndexOf(searchTerm, StringComparison.OrdinalIgnoreCase) >= 0) ||
                   (Genre != null && Genre.IndexOf(searchTerm, StringComparison.OrdinalIgnoreCase) >= 0);
        }

        public string GetBookInfo()
        {
            return $"{Title} автор {Author} ({Year}) - ISBN: {ISBN}, Жанр: {Genre}";
        }

        public bool IsClassic()
        {
            return Year < 1950;
        }
    }

