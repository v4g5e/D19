    // 13. Частичный метод OnRetry() в классе RetryPolicy
    partial class RetryPolicy
    {
        public void ExecuteWithRetry(Action action, int maxRetries)
        {
            for (int attempt = 1; attempt <= maxRetries; attempt++)
            {
                try
                {
                    action();
                    return;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Попытка {attempt} не удалась: {ex.Message}");
                    if (attempt < maxRetries)
                    {
                        OnRetry(attempt, maxRetries, ex);
                    }
                }
            }
        }

        partial void OnRetry(int currentAttempt, int maxAttempts, Exception exception);
    }

    partial class RetryPolicy
    {
        partial void OnRetry(int currentAttempt, int maxAttempts, Exception exception)
        {
            Console.WriteLine($"Повторная попытка {currentAttempt} из {maxAttempts}");
            WaitBeforeRetry(currentAttempt);
            LogRetryAttempt(currentAttempt, exception);
        }

        private void WaitBeforeRetry(int attempt)
        {
            int delay = attempt * 1000;
            Console.WriteLine($"Ожидание {delay} мс перед повторной попыткой...");
            System.Threading.Thread.Sleep(delay);
        }

        private void LogRetryAttempt(int attempt, Exception exception)
        {
            Console.WriteLine($"Логирование повторной попытки {attempt}: {exception.Message}");
        }
    }

    // 14. Частичный метод OnTimeout() в классе Request
    partial class Request
    {
        public void ExecuteWithTimeout(Action action, TimeSpan timeout)
        {
            Console.WriteLine($"Выполнение с таймаутом {timeout.TotalSeconds} сек...");
            try
            {
                action();
            }
            catch (TimeoutException ex)
            {
                OnTimeout(timeout, ex);
                throw;
            }
        }

        partial void OnTimeout(TimeSpan timeout, TimeoutException exception);
    }

    partial class Request
    {
        partial void OnTimeout(TimeSpan timeout, TimeoutException exception)
        {
            Console.WriteLine($"Таймаут запроса: {timeout.TotalSeconds} сек");
            CancelPendingOperations();
            NotifyAboutTimeout();
        }

        private void CancelPendingOperations()
        {
            Console.WriteLine("Отмена ожидающих операций...");
        }

        private void NotifyAboutTimeout()
        {
            Console.WriteLine("Уведомление о таймауте...");
        }
    }

