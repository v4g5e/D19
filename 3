    }

    class Interval
    {
        private readonly DateTime start;
        private readonly DateTime end;

        public DateTime Start { get { return start; } }
        public DateTime End { get { return end; } }

        public Interval(DateTime start, DateTime end)
        {
            if (start >= end)
                throw new ArgumentException("Начало интервала должно быть раньше конца!");

            this.start = start;
            this.end = end;
        }

        public TimeSpan GetDuration()
        {
            return end - start;
        }

        public void DisplayInfo()
        {
            Console.WriteLine($"Интервал: с {Start:dd.MM.yyyy HH:mm} по {End:dd.MM.yyyy HH:mm}");
            Console.WriteLine($"Продолжительность: {GetDuration().TotalHours:F2} часов");
        }
    }

