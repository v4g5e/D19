    class Library
    {
        public string Name { get; set; }
        public string Address { get; set; }
        private List<Book> books;
        private List<Author> authors;

        public Library(string name, string address)
        {
            Name = name;
            Address = address;
            books = new List<Book>();
            authors = new List<Author>();
        }

        public void AddBook(Book book)
        {
            books.Add(book);
            if (!authors.Contains(book.Author))
                authors.Add(book.Author);
        }

        public void RemoveBook(Book book)
        {
            books.Remove(book);
        }

        public Book FindBookByTitle(string title)
        {
            return books.Find(b => b.Title.Equals(title, StringComparison.OrdinalIgnoreCase));
        }

        public List<Book> FindBooksByAuthor(string authorName)
        {
            return books.FindAll(b => b.Author.Name.Equals(authorName, StringComparison.OrdinalIgnoreCase));
        }

        public void DisplayAllBooks()
        {
            Console.WriteLine($"Библиотека '{Name}' - Все книги:");
            foreach (var book in books)
            {
                book.DisplayInfo();
                Console.WriteLine("---");
            }
        }
    }

